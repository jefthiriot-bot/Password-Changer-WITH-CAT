<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>../PasswordPuzzle/app.manifest</ApplicationManifest>
    <ApplicationIcon>../PasswordPuzzle/Assets/PasswordPuzzle-Reset.ico</ApplicationIcon>
    <AssemblyName>PasswordPuzzle-Reset</AssemblyName>
    <RootNamespace>PasswordPuzzle</RootNamespace>
    <Version>1.4.0</Version>
    <DefineConstants>$(DefineConstants);RESET_APP</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../PasswordPuzzle/Assets/Cat.png" LogicalName="PasswordPuzzle.Cat.png" />
    <Compile Include="../PasswordPuzzle/*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
